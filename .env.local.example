SENTRY_AUTH_TOKEN=
NEXT_PUBLIC_BE_URL=http:///127.0.0.1:8000/
NEXT_PUBLIC_API_URL=http:///127.0.0.1:8000/api
FETCH_DEBUG=false
NEXT_PUBLIC_SENTRY_DSN=
IMAGE_REMOTE_PATTERN=http://127.0.0.1
ENABLE_REACT_COMPILER=false
# Segreto condiviso con il back-end Laravel per le rotte pubbliche interne.
# Server-only (NON usare il prefisso NEXT_PUBLIC) e deve coincidere con
# INTERNAL_API_SECRET del back-end.
INTERNAL_API_SECRET=

# Site key del widget Cloudflare Turnstile per il preventivatore
# pubblico. Se vuota, il captcha è disabilitato lato client
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
