  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@faker-js/faker": "^10.0.0",
    "@hookform/devtools": "^4.3.1",
    "@next/bundle-analyzer": "^15.1.4",
    "@tanstack/eslint-plugin-query": "^5.72.2",
    "@types/js-cookie": "^3.0.6",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@typescript-eslint/eslint-plugin": "^8.20.0",
    "babel-plugin-react-compiler": "^19.1.0-rc.2",
    "eslint": "^9.18.0",
    "eslint-config-next": "^15.1.4",
    "eslint-config-prettier": "^10",
    "eslint-plugin-react-compiler": "^19.1.0-rc.2",
    "husky": "^9.0.11",
    "lint-staged": "^16.0.0",
    "npm-run-all2": "^8.0.0",
    "prettier": "^3.1.0",
    "sass": "^1.69.5",
    "semver": "^7.6.3",
    "typescript": "^5"
  },
  "engines": {
    "npm": "~10 || ~11",
    "node": "~24"
  },
  "overrides": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "private": true,
  "scripts": {
    "analyze": "set ANALYZE=true&& npm run build",
    "bs": "npm i && next build && next start",
    "turbo-bs": "npm i && next build --turbo && next start",
    "build": "next build",
    "check-format": "prettier --check .",
    "check-types": "tsc --noEmit",
    "clean-cache": "rm -rf ./.next/",
    "dev": "next dev",
    "dev-debug": "set NODE_OPTIONS=--inspect && next dev",
    "dev-only": "next dev",
    "format": "prettier --write .",
    "lint": "eslint .",
    "lint-staged": "lint-staged",
    "predev": "node ./scripts/checkNodeVersion.mjs && npm i",
    "prepare": "husky",
    "preturbo": "node ./scripts/checkNodeVersion.mjs && npm i",
    "start": "next start -p 3001",
    "turbo": "next dev --turbo",
    "turbobuild": "next build --turbo",
    "u": "npm update && npm run validate",
    "validate": "npm-run-all --print-label --sequential clean-cache --parallel check-format lint check-types --sequential build"
  }
}
